# ------------------------------------------------------------------
# Main Server Block for yuriodev.co.uk (HTTPS)
# This block forwards all traffic to the Docker container.
# ------------------------------------------------------------------
server {
    # Listen on port 443 for secure traffic
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    # Your domain names
    server_name yuriodev.co.uk www.yuriodev.co.uk;

    # SSL Configuration (from Certbot - this should not change)
    ssl_certificate /etc/letsencrypt/live/yuriodev.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yuriodev.co.uk/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Logging
    access_log /var/log/nginx/yuriodev.co.uk.access.log;
    error_log /var/log/nginx/yuriodev.co.uk.error.log;

    # This is the main reverse proxy configuration
    location / {
        # Forward the request to your React app container running on localhost port 3000
        proxy_pass http://127.0.0.1:3000;

        # --- Standard Proxy Headers ---
        # These headers pass information about the original request to your application
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # --- WebSocket Headers (important for Vite's Hot Module Replacement if used, and good practice) ---
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# ------------------------------------------------------------------
# Redirect Server Block (HTTP to HTTPS)
# This block remains the same.
# ------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name yuriodev.co.uk www.yuriodev.co.uk;

    # Certbot's recommended redirect
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 310 https://$host$request_uri;
    }
}